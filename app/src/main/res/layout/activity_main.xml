<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RoadSense"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/startButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Start Detection"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/stopButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Stop Detection"/>
    <Button
        android:id="@+id/viewPotholesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Potholes"
        android:layout_marginTop="16dp"/>
    <Button
        android:id="@+id/viewMapButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Map"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"/>
    <TextView
        android:id="@+id/potholeDetectedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No pothole detected"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/totalPotholesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Potholes: 0"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Idle"
        android:textSize="16sp"
        android:layout_marginTop="40dp"/>

</LinearLayout>